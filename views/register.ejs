<%- include("partials/header", { title: "Regisztáció" }) %>
<section id="main">
    <div class="container">
        <div class="row aln-center">
            <div class="col-6">
            <!-- Main -->
                <% if(message){ %><p class="message"><%= message %></p><% } %>
                <form method="POST" action="/register">
                    <div class="row gtr-25">
                        <div class="col-12">
                            <input type="text" id="username" name="username" placeholder="Felhasználónév"/>
                        </div>
                        <div class="col-12">
                            <input type="password" id="password" name="password" placeholder="Jelszó"/>
                        </div>
                        <div class="col-12">
                            <input type="password" id="password_confirmation" name="password_confirmation" placeholder="Jelszó megerősítése"/>
                        </div>
                        <div class="col-12">
                            <input type="submit" value="Regisztráció"/>
                        </div>
                        <div class="col-12 center-align">
                            <span>Van már fiókod? <a href="/login"><strong>Bejelentkezés</strong></a></span>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
<%- include("partials/footer") %>