<div class="col-6">
    <% if (locals.maxpages && locals.page && locals.perpage) { %>
        <% if (maxpages > 0) { %>
            <div class="row aln-center">
                <div class="col-2 aln-center">
                    <form method="GET">
                        <input type="hidden" name="page" value="<%= page - 1 %>"/>
                        <input type="hidden" name="perpage" value="<%= perpage %>"/>
                        <button type="submit" class="material-symbols-outlined page-btn" <% if (page <= 1) { %> disabled <% } %>>
                            arrow_back
                        </button>
                    </form>
                </div>
                <div class="col-2 aln-center">
                    <h3 class="page-txt"><%= page %> / <%= maxpages %></h3>
                </div>
                <div class="col-2 aln-center">
                    <form method="GET">
                        <input type="hidden" name="page" value="<%= page + 1 %>"/>
                        <input type="hidden" name="perpage" value="<%= perpage %>"/>
                        <button type="submit" class="material-symbols-outlined page-btn" <% if (page >= maxpages) { %> disabled <% } %>>arrow_forward</button>
                    </form>
                </div>
            </div>
    <% }
    } %>
</div>