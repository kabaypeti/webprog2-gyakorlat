<%- include('partials/header', { title: "Üzenet küldése" }) 
%>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=arrow_back,arrow_forward"/>
	<section id="main">
		<div class="container">
			<div class="row aln-center">
				<div id="content" class="col-8 col-12-medium">

					<% if (locals.siker) { %>
                        <div style="padding: 10px; margin-bottom: 15px; background-color: #d4edda; color: #155724; border-radius: 5px;">
                            <%= siker %>
                        </div>
				    <% } %>
					
					<h2>Új üzenet küldése</h2>

					<form action="/uzenet" method="POST" style="margin-top: 20px;">
						<div class="row gtr-uniform">
							<div class="col-12" style="margin-bottom: 5px;">
								<textarea name="uzenet" id="uzenet" rows="5" placeholder="Írd ide az üzeneted..." required><%= locals.uzenet || '' %></textarea>
                                <% if (locals.errors && errors.uzenet) { %>
                                    <small style="color: red;"><%= errors.uzenet %></small>
                                <% } %>
							</div>
							<div class="col-12">
								<button type="submit" class="button primary">Küldés</button>
							</div>
						</div>
					</form>
				</div>
			</div>
		</div>
	</section>
<%- include('partials/footer') %>