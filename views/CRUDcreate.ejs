<%- include('partials/header', { title: "CRUD add" }) 
%>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=arrow_back,arrow_forward"/>
<section id="main">
		<div class="container">
			<div class="row aln-center">
				<div id="content" class="col-8 col-12-medium">
					<h2>Új kategória hozzáadása</h2>
					<form action="/CRUD/" method="POST">
						<div class="row gtr-uniform">
							<div class="col-12">
								<input type="text" name="nev" id="nev" value="<%= locals.nev || '' %>" placeholder="Kategória neve" required />
								<% if (typeof errors !== 'undefined' && errors.nev) { %>
								<small style="color: red;"><%= errors.nev %></small>
							    <% } %>
							</div>
							<div class="col-12">
            					<input type="text" name="ar" id="ar" value="<%= locals.ar || '' %>" inputmode="numeric" pattern="[0-9]*" placeholder="Ár" required />
								<% if (typeof errors !== 'undefined' && errors.ar) { %>
								    <small style="color: red;"><%= errors.ar %></small>
							    <% } %>
							</div>
							<div class="col-12">
								<button type="submit" class="button primary">Mentés</button>
							</div>
						</div>
					</form>
				</div>
			</div>
		</div>
	</section>
<%- include('partials/footer') %>