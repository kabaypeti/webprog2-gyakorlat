<%- include('partials/header', { title: "Adatbázis" }) %>    
<section id="main">
    <div class="container">
        <!-- Main -->
        <div class="row aln-center">
            
            <!-- Content -->
            <div id="content" class="col-8 col-12-medium">
                
                <% if (data) { %>
                    <table>
                        <thead>
                            <% for (let k of columnNames) { %>
                                <th><%=k%></th>
                            <% } %>
                        </thead>
                        <% for (let d of data) { %>
                            <tr>
                                <% for (let key in d) { %>
                                    <td><%=d[key]%></td>
                                <% } %>
                            </tr>
                        <% } %>
                    </table>
                <% } %>
            </div>
        </div>
    </div>
</section>
<%- include('partials/footer') %>