<%- include('partials/header', { title: "CRUD" }) 
%>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=arrow_back,arrow_forward"/>
<section id="main">
    <div class="container">
        <div class="row aln-center">
            <div id="content" class="col-8 col-12-medium">
				<div style="margin-bottom: 15px; text-align: left;">
					<a style="width:100%" href="/CRUD/create" class="button small">
						Új kategória hozzáadása
					</a>
				</div>
                <% if (data) { %>
                    <table>
                        <thead>
                            <% for (let k of columnNames) { %>
                                <th><%=k%></th>
                            <% } %>
                            <th></th>
							<th></th>
                        </thead>
                        <% for (let d of data) { %>
                            <tr>
                                <% for (let key in d) { %>
                                    <td><%=d[key]%></td>
                                <% } %>
                                <td>
                                    <a href="#" class="button small" style="height: auto; line-height: inherit; padding: 0 15px;">Szerkesztés</a>
                                </td>
                                <td>
                                    <a href="#" class="button small alert" onclick="
                                            event.preventDefault();
                                            if (confirm('Biztosan törölni szeretnéd ezt a kategóriát?')) {
                                                document.getElementById('delete-form').submit();
                                            }" style="height: auto; line-height: inherit; padding: 0 15px;">
                                            Törlés</a>
                                    <form id="delete-form" action="#" method="POST" style="margin: 0;">
                                    </form>
                                </td>
                            </tr>
                        <% } %>
                        
                    </table>
                    <%- include("partials/pager", { page, perpage, maxpages }) %>
                <% } %>
            </div>
        </div>
    </div>
</section>
<%- include('partials/footer') %>